# 配置模板 —— 复制为 .env 后填入真实值；.env 已在 .gitignore 中排除，禁止提交真实凭据。
# 所有配置项也可直接以同名环境变量注入（环境变量优先于 .env 文件）。

# ── HIS 出站对接 ──────────────────────────────────────────────
# 院内 HIS / ESB 的基地址，例：https://his-internal.example-hospital.local
# 必填。启动自检会检查该地址是否可达。
HIS_BASE_URL=

# HIS 出站访问令牌。出站请求统一带 Authorization: Bearer <token>。
# 必填。只从环境变量读取，不写入配置文件、不进日志。
HIS_API_TOKEN=

# ── 模型服务（OpenAI-compatible 协议）──────────────────────────
# 模型服务基地址。院内自建端点、本地模型与云服务共用同一配置面，切换只改 base_url。
# 必填。留空表示模型不可达，主路径降级为「只出规则可判清单，语义项转人工判定」。
LLM_BASE_URL=

# 模型服务访问令牌。只从环境变量读取。
LLM_API_KEY=

# 判定长嘱归属所用的模型名。
LLM_MODEL=

# 单次模型调用超时（秒）。默认 30。
LLM_TIMEOUT_SECONDS=30
